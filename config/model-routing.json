{
  "version": 2,
  "keyProfiles": {
    "openai": "openai-primary",
    "zenmux": "zenmux-router"
  },
  "tiers": {
    "low": {
      "openai": "gpt-5-mini",
      "zenmux": "anthropic/claude-haiku-4.5"
    },
    "medium": {
      "openai": "gpt-5",
      "zenmux": "anthropic/claude-sonnet-4"
    },
    "high": {
      "openai": "gpt-5",
      "zenmux": "x-ai/grok-4.5"
    }
  },
  "roleDefaults": {
    "intake_clarification": "low",
    "initial_drafter": "medium",
    "strategist": "low",
    "skeptic": "low",
    "editor": "low",
    "synthesizer": "low",
    "originality_landscape": "medium",
    "final_drafter": "medium"
  },
  "escalation": {
    "allowedOnlyWhen": [
      "user explicitly selects a higher-capability model",
      "reviewer confidence is below the configured threshold",
      "strategist and skeptic materially disagree",
      "structured output repeatedly fails",
      "content is high stakes",
      "complex claims require deeper reasoning",
      "user requests a final high-confidence review",
      "a lower-cost result was inadequate"
    ],
    "requireBudgetCheck": true,
    "neverAssumeHigherCostIsBetter": true
  }
}
